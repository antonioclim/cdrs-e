{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cdrse:selection-problem:0.1.0",
  "title": "CDRS-E selection problem",
  "type": "object",
  "additionalProperties": false,
  "required": ["constraints", "activation_costs"],
  "properties": {
    "model": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["coefficients", "innovation_covariance"],
          "properties": {
            "coefficients": {
              "type": "array", "minItems": 1,
              "items": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}}
            },
            "innovation_covariance": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}},
            "channel_names": {"type": "array", "items": {"type": "string"}},
            "metadata": {"type": "object"}
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exact_k": {"type": ["integer", "null"], "minimum": 0},
        "k_min": {"type": "integer", "minimum": 0, "default": 0},
        "k_max": {"type": ["integer", "null"], "minimum": 0},
        "budget": {"type": ["number", "null"], "minimum": 0},
        "mandatory": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "forbidden": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "coverage_groups": {"type": "array", "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}},
        "exclude_empty": {"type": "boolean", "default": true},
        "exclude_full": {"type": "boolean", "default": true}
      }
    },
    "activation_costs": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}},
    "cut_weights": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0}}}
      ]
    },
    "information_weight": {"type": "number", "minimum": 0, "default": 1},
    "cost_weight": {"type": "number", "minimum": 0, "default": 0},
    "metadata": {"type": "object"}
  }
}
